@TEXT_CENTER_X = 170
@TEXT_RIGHT_X = 315
@TEXTS_Y = 215

guiTypes = {	#宣传鼓动部

	containerWindowType = {
		name = "xchinese_propaganda_campaigns_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 250 }

		#BACKGROUND
		iconType = {
			name ="xchinese_propaganda_bg"
			spriteType = "GFX_X_xchinese_propaganda_bg"
			position = { 
				x=@BACKGROUND_X 
				y=@BACKGROUND_Y 
			}
		}

		#POSTER LEFT
		iconType = {
			name ="propaganda_poster_xchinese_left"
			position = { 
				x=@POSTER_LEFT_X	 
				y=@POSTERS_Y 
			}
			pdx_tooltip = xchinese_PROPAGANDA_CAMPAIGN_TT_LEFT
		}
		#Days remaining
		instantTextBoxType = {
			name ="poster_xchinese_left_text"
			position = { 
				x = @TEXT_LEFT_X 
				y = @TEXTS_Y 
			}
			font = "hoi_18mbs"
			text = "xchinese_poster_left_text"
			format = center
			maxWidth = 150
		}

		#POSTER CENTER
		iconType = {
			name ="propaganda_poster_xchinese_center"
			position = { 
				x=@POSTER_CENTER_X	 
				y=@POSTERS_Y 
			}
			pdx_tooltip = xchinese_PROPAGANDA_CAMPAIGN_TT_CENTER
		}
		#Days Remaining
		instantTextBoxType = {
			name ="poster_xchinese_center_text"
			position = { 
				x = @TEXT_CENTER_X 
				y = @TEXTS_Y 
			}
			font = "hoi_18mbs"
			text = "xchinese_poster_center_text"
			format = center
			maxWidth = 150
		}

		#POSTER RIGHT
		iconType = {
			name ="propaganda_poster_xchinese_right"
			position = { 
				x=@POSTER_RIGHT_X	 
				y=@POSTERS_Y 
			}
			pdx_tooltip = xchinese_PROPAGANDA_CAMPAIGN_TT_RIGHT
		}
		#Days Remaining
		instantTextBoxType = {
			name ="poster_xchinese_right_text"
			position = { 
				x = @TEXT_RIGHT_X 
				y = @TEXTS_Y 
			}
			font = "hoi_18mbs"
			text = "xchinese_poster_right_text"
			format = center
			maxWidth = 150
		}
	}

}

